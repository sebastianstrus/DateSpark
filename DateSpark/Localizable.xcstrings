    "Bookmark questions that spark something real. Return to your collection whenever you need the right words.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Fragen, die etwas Echtes auslösen. Kehren Sie zu Ihrer Sammlung zurück, wann immer Sie die richtigen Worte brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark questions that spark something real. Return to your collection whenever you need the right words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca preguntas que generen algo real. Vuelve a tu colección cuando necesites las palabras correctas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les questions qui suscitent quelque chose de réel. Revenez à votre collection chaque fois que vous avez besoin des bons mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le domande che accendono qualcosa di vero. Torna alla tua raccolta ogni volta che hai bisogno delle parole giuste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か本物を呼び起こす質問をブックマークしましょう。適切な言葉が必要なときはいつでもコレクションに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진정한 감정을 불러일으키는 질문을 북마크하세요. 올바른 말이 필요할 때마다 컬렉션으로 돌아오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer vragen die iets echts oproepen. Keer terug naar je collectie wanneer je de juiste woorden nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do zakładek pytania, które wywołują coś prawdziwego. Wracaj do swojej kolekcji, gdy potrzebujesz odpowiednich słów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque perguntas que despertem algo real. Volte à sua coleção sempre que precisar das palavras certas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏能激发真实情感的问题。当你需要合适的话语时，随时回到你的收藏。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokmerk spørsmål som vekker noe ekte. Gå tilbake til samlingen din når du trenger de riktige ordene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokmärk frågor som väcker något äkta. Återvänd till din samling när du behöver de rätta orden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладайте запитання, що викликають щось справжнє. Повертайтеся до своєї колекції, коли вам потрібні правильні слова."
          }
        }
      }
    },
