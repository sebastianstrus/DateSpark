    "onboarding.page3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie nach rechts, wenn eine Frage Sie anspricht. Wischen Sie nach links, um zu überspringen. Jede Karte ist eine Tür – öffnen Sie die, die Sie rufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right when a question resonates. Swipe left to pass. Every card is a doorway — open the ones that call to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha cuando una pregunta resuene contigo. Desliza a la izquierda para pasar. Cada tarjeta es una puerta: abre las que te llaman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez à droite quand une question résonne. Glissez à gauche pour passer. Chaque carte est une porte — ouvrez celles qui vous appellent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra quando una domanda ti risuona. Scorri a sinistra per passare oltre. Ogni carta è una porta: apri quelle che ti chiamano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心に響く質問があれば右にスワイプ。スキップするなら左にスワイプ。すべてのカードは扉です — あなたを呼ぶものを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문이 공감되면 오른쪽으로 스와이프하세요. 건너뛰려면 왼쪽으로 스와이프하세요. 모든 카드는 문입니다 — 당신을 부르는 것을 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til høyre når et spørsmål resonnerer. Sveip til venstre for å hoppe over. Hvert kort er en dør — åpne de som kaller på deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar rechts als een vraag resoneert. Veeg naar links om over te slaan. Elke kaart is een deur — open degene die je roepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w prawo, gdy pytanie do Ciebie przemawia. Przesuń w lewo, by pominąć. Każda karta to drzwi — otwórz te, które do Ciebie wołają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita quando uma pergunta ressoar. Deslize para a esquerda para passar. Cada cartão é uma porta — abra as que chamam você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt höger när en fråga resonerar. Svep åt vänster för att hoppa över. Varje kort är en dörr — öppna de som kallar på dig."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть праворуч, якщо запитання відгукується. Проведіть ліворуч, щоб пропустити. Кожна картка — це двері — відкрийте ті, що кличуть вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当问题引起共鸣时向右滑动。向左滑动跳过。每张卡片都是一扇门——打开那些呼唤你的。"
          }
        }
      }
    },
