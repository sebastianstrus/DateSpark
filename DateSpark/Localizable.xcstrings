    "Would you prefer a night of endless teasing or a night of pure, uninterrupted passion?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Würdest du eine Nacht voller endloser Neckereien oder eine Nacht voller reiner, ununterbrochener Leidenschaft bevorzugen?" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Would you prefer a night of endless teasing or a night of pure, uninterrupted passion?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Preferirías una noche de bromas interminables o una noche de pasión pura e ininterrumpida?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préférerais-tu une nuit de taquineries sans fin ou une nuit de passion pure et ininterrompue ?" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Preferiresti una notte di infinite provocazioni o una notte di pura e ininterrotta passione?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "終わりのないからかいの夜と、純粋で途切れることのない情熱の夜、どちらがいいですか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "끝없는 놀림의 밤과 순수하고 끊임없는 열정의 밤 중 무엇을 선호하시나요?" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Ville du foretrukket en natt med endeløs erting eller en natt med ren, uavbrutt lidenskap?" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Zou je de voorkeur geven aan een nacht van eindeloos plagen of een nacht van pure, ononderbroken passie?" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wolałbyś noc niekończącego się drażnienia czy noc czystej, nieprzerwanej namiętności?" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você preferiria uma noite de provocações sem fim ou uma noite de paixão pura e ininterrupta?" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Skulle du föredra en natt av oändlig retning eller en natt av ren, oavbruten passion?" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ви б віддали перевагу ночі нескінченних дражнинь чи ночі чистої, безперервної пристрасті?" } },
