          }
        }
      }
    },
    "Tell your partner something that you like about them already." : {
      "comment" : "category: closeness36, depth: medium",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag deinem Partner etwas, das du jetzt schon an ihm magst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a tu compañero algo que ya te guste de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis à ton partenaire quelque chose que tu aimes déjà chez lui/elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di al tuo partner qualcosa che già ti piace di lui/lei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーに、もうすでに気に入っている点を伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파트너에게 당신이 이미 좋아하는 점을 말해주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell partneren din noe du allerede liker ved dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel je partner iets dat je nu al leuk aan hen vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz swojemu partnerowi coś, co już teraz w nim lubisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga ao seu parceiro algo que você já gosta nele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta för din partner något du redan gillar hos dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажіть партнеру щось, що вам у ньому/ній уже подобається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你的伴侣你已经喜欢上他们的某个方面。"
          }
        }
      }
    },
    "Tell your partner what you like about them; be very honest, saying things you might not say to someone you’ve just met." : {
      "comment" : "category: closeness36, depth: deep",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag deinem Partner, was du an ihm magst; sei sehr ehrlich und sage Dinge, die du vielleicht nicht zu jemandem sagen würdest, den du gerade erst kennengelernt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a tu compañero lo que te gusta de él; sé muy honesto, diciendo cosas que quizás no le dirías a alguien que acabas de conocer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis à ton partenaire ce que tu aimes chez lui/elle ; sois très honnête, en disant des choses que tu ne dirais peut-être pas à quelqu’un que tu viens de rencontrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di al tuo partner cosa ti piace di lui/lei; sii molto onesto, dicendo cose che forse non diresti a qualcuno che hai appena incontrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーにどこが好きかを伝えてください。非常に正直に、初対面の人には言わないようなことを話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파트너에게 당신이 그/그녀의 어떤 점을 좋아하는지 말하세요. 매우 솔직하게, 방금 만난 사람에게는 하지 않을 말도 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell partneren din hva du liker ved dem; vær veldig ærlig, si ting du kanskje ikke ville sagt til noen du nettopp har møtt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel je partner wat je leuk aan hen vindt; wees heel eerlijk, zeg dingen die je misschien niet zou zeggen tegen iemand die je net hebt ontmoet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz swojemu partnerowi, co w nim lubisz; bądź bardzo szczery, mówiąc rzeczy, których możesz nie powiedzieć komuś, kogo właśnie poznałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga ao seu parceiro o que você gosta nele; seja muito honesto, dizendo coisas que talvez não dissesse a alguém que acabou de conhecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta för din partner vad du gillar hos dem; var väldigt ärlig och säg saker du kanske inte skulle säga till någon du precis har träffat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажіть партнеру, що вам у ньому/ній подобається; будьте дуже чесними, кажіть речі, які ви, можливо, не сказали б комусь, кого щойно зустріли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你的伴侣你喜欢他们什么；要非常诚实，说出你可能不会对刚认识的人说的话。"
          }
        }
      }
    },
