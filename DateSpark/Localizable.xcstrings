    "Thoughtfully crafted questions designed to move past small talk — for first dates, old friends, and every meaningful encounter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgfältig gestaltete Fragen, die über Small Talk hinausgehen — für erste Dates, alte Freunde und jede bedeutungsvolle Begegnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoughtfully crafted questions designed to move past small talk — for first dates, old friends, and every meaningful encounter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntas cuidadosamente diseñadas para ir más allá de la charla trivial — para primeras citas, viejos amigos y cada encuentro significativo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions soigneusement conçues pour aller au-delà des banalités — pour les premiers rendez-vous, les vieux amis et chaque rencontre significative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domande accuratamente create per andare oltre le chiacchiere — per primi appuntamenti, vecchi amici e ogni incontro significativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初デート、旧友、すべての有意義な出会いのために、世間話を超えるように設計された丁寧に作られた質問。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 데이트, 오랜 친구, 그리고 모든 의미 있는 만남을 위해 가벼운 대화를 넘어서도록 세심하게 만들어진 질문들."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorgvuldig samengestelde vragen die verder gaan dan small talk — voor eerste dates, oude vrienden en elke betekenisvolle ontmoeting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starannie opracowane pytania zaprojektowane, aby wykroczyć poza small talk — na pierwsze randki, starych przyjaciół i każde znaczące spotkanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntas cuidadosamente elaboradas para ir além de conversas triviais — para primeiros encontros, velhos amigos e cada encontro significativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精心设计的问题，旨在超越闲聊——适用于初次约会、老朋友和每一次有意义的相遇。"
          }
        }
      }
    },
