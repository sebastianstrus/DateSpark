        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdybyś miał umrzeć dziś wieczorem, czego najbardziej żałowałbyś, że nie powiedziałeś komuś? Dlaczego jeszcze mu nie powiedziałeś?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
