    "Share a personal problem and ask your partner’s advice on how they might handle it." : {
      "comment" : "category: closeness36, depth: deep",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile ein persönliches Problem und bitte deinen Partner um Rat, wie er damit umgehen würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte un problema personal y pide el consejo de tu compañero sobre cómo podría manejarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage un problème personnel et demande conseil à ton partenaire sur la façon dont il/elle pourrait le gérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi un problema personale e chiedi al tuo partner un consiglio su come potrebbe gestirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人的な問題を共有し、その対処法についてパートナーのアドバイスを求めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인적인 문제를 공유하고 파트너에게 어떻게 대처할지 조언을 구하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del et personlig problem og spør partneren din om råd om hvordan de ville håndtert det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel een persoonlijk probleem en vraag je partner om advies over hoe hij of zij het zou aanpakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel się osobistym problemem i poproś partnera o radę, jak on by go rozwiązał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe um problema pessoal e peça conselho ao seu parceiro sobre como ele lidaria com isso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela ett personligt problem och be din partner om råd om hur de skulle hantera det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться особистою проблемою та попросіть партнера поради, як він/вона міг би її вирішити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
