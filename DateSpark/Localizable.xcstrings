            "value" : "Zou je willen weten of je partner je zou verlaten voordat hij of zij het deed?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chciałbyś wiedzieć, czy twój partner cię opuści, zanim to zrobi?"
