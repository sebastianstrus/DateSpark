    "Of all the people in your family, whose death would you find most disturbing? Why?" : {
      "comment" : "category: closeness36, depth: deep",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
