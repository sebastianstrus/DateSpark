    "Spin the wheel to discover a category,\nor browse all ten themes." : {
      "comment" : "A description of the spinning wheel.",
      "isCommentAutoGenerated" : true
    },
    "Spin the wheel to discover a category,\\nor browse all ten themes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehen Sie das Rad, um eine Kategorie zu entdecken,\\noder durchsuchen Sie alle zehn Themen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spin the wheel to discover a category,\\nor browse all ten themes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la rueda para descubrir una categoría,\\no explora los diez temas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez la roue pour découvrir une catégorie,\\nou parcourez les dix thèmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la ruota per scoprire una categoria,\\no sfoglia tutti i dieci temi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホイールを回してカテゴリーを発見するか、\\n10のテーマすべてを閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휠을 돌려 카테고리를 발견하거나,\\n10가지 테마 모두를 둘러보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai aan het wiel om een categorie te ontdekken,\\nof blader door alle tien thema's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obróć koło, aby odkryć kategorię,\\nlub przeglądaj wszystkie dziesięć tematów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire a roda para descobrir uma categoria,\\nou navegue por todos os dez temas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旋转轮盘发现一个分类,\\n或浏览所有十个主题。"
          }
        }
      }
    },
