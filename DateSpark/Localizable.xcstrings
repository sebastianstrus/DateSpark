        "ja" : { "stringUnit" : { "state" : "translated", "value" : "私たちの一番情熱的な瞬間を書き換えられるとしたら、長くしますか？もっとワイルドにしますか？それとももっと甘くしますか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "우리의 가장 열정적인 순간을 다시 쓸 수 있다면, 더 길게, 더 거칠게, 아니면 더 달콤하게 만들겠습니까?" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Hvis du kunne skrive om vårt mest lidenskapelige øyeblikk sammen, ville du gjort det lengre, villere eller søtere?" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Als je ons meest passionele moment samen opnieuw zou kunnen schrijven, zou je het dan langer, wilder of zoeter maken?" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Gdybyś mógł przepisać nasz najbardziej namiętny wspólny moment, czy uczyniłbyś go dłuższym, dzikszym czy słodszym?" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Se você pudesse reescrever nosso momento mais apaixonado juntos, você o tornaria mais longo, mais selvagem ou mais doce?" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Om du kunde skriva om vårt mest passionerade ögonblick tillsammans, skulle du göra det längre, vildare eller sötare?" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Якби ви могли переписати наш найпристрасніший спільний момент, ви б зробили його довшим, дикішим чи солодшим?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如果你能重写我们最热烈的那一刻，你会让它更长、更狂野，还是更甜蜜？" } }
      }
    },
    "What is the line between a sweet, romantic touch and a touch that means 'I want you right now'?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo ist die Grenze zwischen einer süßen, romantischen Berührung und einer Berührung, die 'Ich will dich jetzt' bedeutet?" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "What is the line between a sweet, romantic touch and a touch that means 'I want you right now'?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cuál es la línea entre un toque dulce y romántico y un toque que significa 'te quiero ahora mismo'?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Où est la limite entre un toucher doux et romantique et un toucher qui signifie 'je te veux tout de suite' ?" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Dov'è il confine tra un tocco dolce e romantico e un tocco che significa 'ti voglio adesso'?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "甘くロマンチックなタッチと『今すぐあなたが欲しい』というタッチの境界線はどこですか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "달콤하고 낭만적인 터치와 '지금 당신을 원해'라는 터치 사이의 경계는 무엇인가요?" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Hvor er grensen mellom en søt, romantisk berøring og en berøring som betyr 'jeg vil ha deg akkurat nå'?" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Waar ligt de grens tussen een lieve, romantische aanraking en een aanraking die betekent 'ik wil je nu'?" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Gdzie jest granica między słodkim, romantycznym dotykiem a dotykiem, który znaczy 'chcę cię teraz'?" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Qual é a linha entre um toque doce e romântico e um toque que significa 'eu quero você agora'?" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Var går gränsen mellan en söt, romantisk beröring och en beröring som betyder 'jag vill ha dig just nu'?" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Де межа між ніжним романтичним дотиком і дотиком, який означає 'я хочу тебе зараз'?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "甜蜜浪漫的触摸和意味着“我现在就想要你”的触摸之间的界线是什么？" } }
