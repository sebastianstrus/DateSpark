          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já fugiu de casa (mesmo que por apenas uma hora)?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du någonsin rymt hemifrån (även bara för en timme)?"
