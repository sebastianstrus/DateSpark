        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가출한 적이 있나요(단 한 시간이라도)?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du noen gang rømt hjemmefra (selv bare for en time)?"
