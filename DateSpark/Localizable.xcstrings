    "Was there a moment growing up that shaped who you are today?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gab es einen Moment in deiner Kindheit, der dich zu dem gemacht hat, der du heute bist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was there a moment growing up that shaped who you are today?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hubo un momento en el crecimiento que definió quién eres hoy?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y a-t-il eu un moment, en grandissant, qui a forgé qui tu es aujourd'hui ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è stato un momento della crescita che ha plasmato la persona che sei oggi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の自分を形作った子供時代の瞬間はありますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성장하면서 오늘날의 당신을 만든 순간이 있었나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var det et øyeblikk i oppveksten som formet den du er i dag?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was er een moment tijdens het opgroeien dat heeft gevormd wie je nu bent?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy był moment w dorastaniu, który ukształtował to, kim jesteś dzisiaj?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houve um momento durante o crescimento que moldou quem você é hoje?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanns det ett ögonblick under uppväxten som formade den du är idag?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи був момент у дорослішанні, який сформував вас сьогоднішнього?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成长过程中有没有哪个瞬间塑造了今天的你？"
          }
        }
      }
    },
    "Was there something you were passionate about as a kid that you've let go of?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gab es etwas, wofür du als Kind leidenschaftlich warst, das du aufgegeben hast?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was there something you were passionate about as a kid that you've let go of?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hubo algo que te apasionara de niño y que hayas dejado ir?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y avait-il quelque chose qui te passionnait étant enfant et que tu as laissé tomber ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'era qualcosa per cui eri appassionato da bambino e che hai lasciato perdere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子供の頃に夢中で、今は手放してしまったものは何ですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어릴 때 열정적이었지만 놓아버린 것이 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var det noe du var lidenskapelig opptatt av som barn som du har sluppet taket i?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was er iets waar je als kind gepassioneerd over was waar je afstand van hebt gedaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy było coś, czym pasjonowałeś/pasjonowałaś się jako dziecko, a co porzuciłeś/porzuciłaś?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houve algo pelo qual você era apaixonado quando criança e que você abandonou?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanns det något du brann för som barn som du har släppt?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи було щось, чим ви захоплювалися в дитинстві, але потім залишили?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你小时候曾热衷但后来放弃了什么？"
          }
        }
      }
    },
