    "Did you ever run away from home (even just for an hour)?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du jemals von zu Hause weggelaufen (auch nur für eine Stunde)?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you ever run away from home (even just for an hour)?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Alguna vez te escapaste de casa (aunque solo fuera por una hora)?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As-tu déjà fugué de la maison (ne serait-ce que pour une heure) ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei mai scappato di casa (anche solo per un'ora)?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家出をしたことはありますか（たとえ1時間だけでも）？"
