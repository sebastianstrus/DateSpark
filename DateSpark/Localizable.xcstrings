        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du skulle dø i kveld, hva ville du angret mest på at du ikke hadde fortalt noen? Hvorfor har du ikke fortalt det ennå?"
