    "Do we have a responsibility to be happy, or is happiness just a byproduct?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben wir eine Verantwortung, glücklich zu sein, oder ist Glück nur ein Nebenprodukt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do we have a responsibility to be happy, or is happiness just a byproduct?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tenemos la responsabilidad de ser felices o la felicidad es solo un subproducto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avons-nous la responsabilité d'être heureux, ou le bonheur n'est-il qu'un sous-produit ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo la responsabilità di essere felici, o la felicità è solo un sottoprodotto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちには幸せになる責任がありますか、それとも幸せは単なる副産物ですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행복해야 할 책임이 있을까요, 아니면 행복은 그저 부산물일까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har vi et ansvar for å være lykkelige, eller er lykke bare et biprodukt?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebben we de verantwoordelijkheid om gelukkig te zijn, of is geluk slechts een bijproduct?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy mamy obowiązek być szczęśliwi, czy szczęście jest tylko produktem ubocznym?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temos a responsabilidade de ser felizes, ou a felicidade é apenas um subproduto?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har vi ett ansvar att vara lyckliga, eller är lycka bara en biprodukt?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи маємо ми відповідальність бути щасливими, чи щастя — це просто побічний продукт?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们有责任去快乐，还是快乐只是一种副产品？"
          }
        }
      }
    },
