        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toutes les personnes de ta famille, la mort de qui trouverais-tu la plus troublante ? Pourquoi ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tutte le persone della tua famiglia, la cui morte troveresti più inquietante? Perché?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族の中で、誰の死が最も動揺すると思いますか？なぜですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 중 누군가의 죽음이 가장 불안하게 느껴지겠습니까? 왜 그럴까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av alle menneskene i familien din, hvem sin død ville du funnet mest forstyrrende? Hvorfor?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van alle mensen in je familie, wiens dood zou je het meest verontrustend vinden? Waarom?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze wszystkich osób w twojej rodzinie, czyja śmierć byłaby dla ciebie najbardziej niepokojąca? Dlaczego?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De todas as pessoas da sua família, cuja morte você acharia mais perturbadora? Por quê?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av alla människor i din familj, vems död skulle du finna mest störande? Varför?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З усіх людей у вашій родині, чия смерть була б для вас найбільш тривожною? Чому?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你家里所有人中，谁的去世最让你感到不安？为什么？"
          }
        }
      }
    },
