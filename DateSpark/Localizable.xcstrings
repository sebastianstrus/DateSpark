    "Tap the bookmark on any question card to add it to your personal collection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf das Lesezeichen auf einer Fragenkarte, um sie zu Ihrer persönlichen Sammlung hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the bookmark on any question card to add it to your personal collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el marcador en cualquier tarjeta de pregunta para agregarla a tu colección personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le signet sur n'importe quelle carte de question pour l'ajouter à votre collection personnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il segnalibro su qualsiasi carta domanda per aggiungerla alla tua raccolta personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問カードのブックマークをタップして、個人コレクションに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 카드의 북마크를 탭하여 개인 컬렉션에 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de bladwijzer op een vraagkaart om deze aan je persoonlijke collectie toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij zakładki na dowolnej karcie pytania, aby dodać ją do swojej kolekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no marcador em qualquer cartão de pergunta para adicioná-lo à sua coleção pessoal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任何问题卡片上的书签，将其添加到您的个人收藏。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bokmerket på et spørsmålskort for å legge det til i din personlige samling."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
