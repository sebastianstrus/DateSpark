    "Swipe right when a question resonates. Swipe left to pass. Every card is a doorway — open the ones that call to you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen Sie nach rechts, wenn eine Frage Sie anspricht. Wischen Sie nach links, um zu überspringen. Jede Karte ist eine Tür — öffnen Sie die, die Sie ansprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right when a question resonates. Swipe left to pass. Every card is a doorway — open the ones that call to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha cuando una pregunta resuene. Desliza a la izquierda para pasar. Cada carta es una puerta — abre las que te llamen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vers la droite lorsqu'une question résonne. Glissez vers la gauche pour passer. Chaque carte est une porte — ouvrez celles qui vous appellent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a destra quando una domanda risuona. Scorri a sinistra per passare. Ogni carta è una porta — apri quelle che ti chiamano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問が心に響いたら右にスワイプ。スキップするには左にスワイプ。すべてのカードは入り口です — あなたを呼ぶものを開けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문이 공감되면 오른쪽으로 스와이프하세요. 패스하려면 왼쪽으로 스와이프하세요. 모든 카드는 문입니다 — 당신을 부르는 것을 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts wanneer een vraag resoneert. Veeg naar links om over te slaan. Elke kaart is een deuropening — open degene die je aanspreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w prawo, gdy pytanie rezonuje. Przesuń w lewo, aby pominąć. Każda karta to drzwi — otwórz te, które cię wzywają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a direita quando uma pergunta ressoar. Deslize para a esquerda para passar. Cada cartão é uma porta — abra os que chamam você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当问题引起共鸣时向右滑动。向左滑动跳过。每张卡片都是一扇门——打开那些呼唤你的。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip til høyre når et spørsmål resonnerer. Sveip til venstre for å hoppe over. Hvert kort er en døråpning — åpne de som kaller på deg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep höger när en fråga resonerar. Svep vänster för att hoppa över. Varje kort är en dörröppning — öppna de som kallar på dig."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортайте праворуч, коли запитання резонує. Гортайте ліворуч, щоб пропустити. Кожна картка — це двері — відкрийте ті, що вас кличуть."
          }
        }
      }
    },
