    "Spin the wheel to discover a category,\nor browse all ten themes.": {
      "comment": "A description of the spinning wheel.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snurr hjulet for å oppdage en kategori,\neller bla gjennom alle ti temaene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snurra hjulet för att upptäcka en kategori,\neller bläddra bland alla tio teman."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутіть колесо, щоб відкрити категорію,\nабо перегляньте всі десять тем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie das Rad, um eine Kategorie zu entdecken,\noder durchsuchen Sie alle zehn Themen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la rueda para descubrir una categoría,\no explora los diez temas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites tourner la roue pour découvrir une catégorie,\nou parcourez les dix thèmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la ruota per scoprire una categoria,\no sfoglia tutti e dieci i temi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールを回してカテゴリーを見つけるか、\n10のテーマすべてを閲覧してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠을 돌려 카테고리를 찾거나,\n10개의 테마를 모두 둘러보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan het wiel om een categorie te ontdekken,\nof blader door alle tien thema's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakręć kołem, aby odkryć kategorię,\nlub przeglądaj wszystkie dziesięć tematów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a roda para descobrir uma categoria,\nou navegue por todos os dez temas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转轮盘以发现类别，\n或浏览所有十个主题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin the wheel to discover a category,\nor browse all ten themes."
          }
        }
      }
    },
