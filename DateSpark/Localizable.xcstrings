        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどの人とは違う愛し方をしていると思いますか？またどのように違いますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 대부분의 사람들과 다르게 사랑한다고 생각하나요? 그리고 어떻게 다른가요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tror du at du elsker annerledes enn de fleste mennesker – og hvordan?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk je dat je anders liefhebt dan de meeste mensen — en hoe?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy myślisz, że kochasz inaczej niż większość ludzi — i jak?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você acha que ama de forma diferente da maioria das pessoas — e como?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tror du att du älskar annorlunda än de flesta människor — och hur?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи думаєте ви, що любите інакше, ніж більшість людей, і як саме?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你认为你爱的方式和大多数人不同吗？如果不同，怎么不同？"
          }
        }
      }
    },
