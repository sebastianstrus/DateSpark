    "Did you ever run away from home (even just for an hour)?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du jemals von zu Hause weggelaufen (auch nur für eine Stunde)?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you ever run away from home (even just for an hour)?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Alguna vez te escapaste de casa (aunque solo fuera por una hora)?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As-tu déjà fugué de la maison (ne serait-ce que pour une heure) ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei mai scappato di casa (anche solo per un'ora)?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家出をしたことはありますか（たとえ1時間だけでも）？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가출한 적이 있나요(단 한 시간이라도)?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du noen gang rømt hjemmefra (selv bare for en time)?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben je ooit van huis weggelopen (ook al was het maar voor een uur)?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy kiedykolwiek uciekłeś/uciekłaś z domu (nawet tylko na godzinę)?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já fugiu de casa (mesmo que por apenas uma hora)?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du någonsin rymt hemifrån (även bara för en timme)?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи ви коли-небудь тікали з дому (хоча б на годину)?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你曾经离家出走过吗（哪怕只有一个小时）？"
          }
        }
      }
    },
    "Did you have a best friend growing up? What were they like?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hattest du als Kind einen besten Freund/eine beste Freundin? Wie war er/sie?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you have a best friend growing up? What were they like?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tuviste un mejor amigo mientras crecías? ¿Cómo era?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avais-tu un meilleur ami/une meilleure amie en grandissant ? Comment était-il/elle ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avevi un migliore amico/una migliore amica da bambino? Com'era?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子供の頃、親友はいましたか？どんな人でしたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어릴 적 가장 친한 친구가 있었나요? 그 친구는 어떤 사람이었나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadde du en bestevenn da du vokste opp? Hvordan var han/hun?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Had je een beste vriend(in) tijdens je jeugd? Hoe was hij/zij?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy miałeś/miałaś najlepszego przyjaciela w dzieciństwie? Jaki był/jaka była?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você teve um melhor amigo durante a infância? Como ele/ela era?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hade du en bästa vän när du växte upp? Hur var han/hon?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи був у вас найкращий друг у дитинстві? Яким він/вона був/була?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你小时候有最好的朋友吗？他/她是什么样的人？"
          }
        }
      }
    },
    "Did you have a childhood nickname? How did you feel about it?" : {
