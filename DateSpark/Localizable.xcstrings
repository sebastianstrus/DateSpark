    "onboarding.page2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von sanften Eisbrechern bis zu tiefgründigen Fragen über Liebe und Leben. Drehen Sie das Rad oder wählen Sie Ihre eigene Richtung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From gentle ice-breakers to profound questions about love and life. Spin the wheel or choose your own direction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde rompehielos suaves hasta preguntas profundas sobre el amor y la vida. Gira la rueda o elige tu propia dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des brise-glaces doux aux questions profondes sur l'amour et la vie. Faites tourner la roue ou choisissez votre propre direction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai rompighiaccio delicati alle domande profonde sull'amore e sulla vita. Gira la ruota o scegli la tua direzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしいアイスブレイカーから、愛と人生についての深い質問まで。ルーレットを回すか、自分で方向を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 아이스브레이커부터 사랑과 삶에 대한 깊은 질문까지. 휠을 돌리거나 직접 방향을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra milde isbrytere til dype spørsmål om kjærlighet og liv. Spinn hjulet eller velg din egen retning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van zachte ijsbrekers tot diepgaande vragen over liefde en leven. Draai aan het wiel of kies je eigen richting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od delikatnych lodołamaczy po głębokie pytania o miłość i życie. Zakręć kołem lub wybierz własny kierunek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quebra-gelos suaves a perguntas profundas sobre amor e vida. Gire a roda ou escolha sua própria direção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från milda isbrytare till djupgående frågor om kärlek och liv. Snurra hjulet eller välj din egen riktning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від м'яких розминок до глибоких запитань про кохання та життя. Крутіть колесо або оберіть свій напрямок."
