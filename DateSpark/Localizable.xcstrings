    "Take four minutes and tell your partner your life story in as much detail as possible." : {
      "comment" : "category: closeness36, depth: medium",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm dir vier Minuten und erzähle deinem Partner deine Lebensgeschichte so detailliert wie möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómate cuatro minutos y cuéntale a tu compañero la historia de tu vida con el mayor detalle posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends quatre minutes pour raconter à ton partenaire l’histoire de ta vie, avec le plus de détails possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi quattro minuti e racconta al tuo partner la storia della tua vita nel modo più dettagliato possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4分間かけて、あなたの人生の物語をできるだけ詳細にパートナーに話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4분 동안 파트너에게 당신의 인생 이야기를 가능한 한 자세하게 들려주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk fire minutter på å fortelle partneren din livshistorien din så detaljert som mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem vier minuten de tijd om je partner je levensverhaal in zo veel mogelijk detail te vertellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poświęć cztery minuty i opowiedz swojemu partnerowi historię swojego życia tak szczegółowo, jak to możliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe quatro minutos contando ao seu parceiro a história da sua vida com o máximo de detalhes possível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta fyra minuter på dig att berätta din livshistoria för din partner så detaljerat som möjligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виділіть чотири хвилини та розкажіть партнеру історію свого життя якомога детальніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花四分钟时间，尽可能详细地告诉你的伴侣你的人生故事。"
          }
        }
      }
    },
    "Tap the bookmark on any question card to add it to your personal collection." : {
      "localizations" : {
