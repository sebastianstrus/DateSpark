    "Of all the people in your family, whose death would you find most disturbing? Why?" : {
      "comment" : "category: closeness36, depth: deep",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von allen Menschen in deiner Familie, wessen Tod würdest du am beunruhigendsten finden? Warum?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De todas las personas de tu familia, ¿la muerte de quién te resultaría más perturbadora? ¿Por qué?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toutes les personnes de ta famille, la mort de qui trouverais-tu la plus troublante ? Pourquoi ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tutte le persone della tua famiglia, la cui morte troveresti più inquietante? Perché?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族の中で、誰の死が最も動揺すると思いますか？なぜですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 중 누군가의 죽음이 가장 불안하게 느껴지겠습니까? 왜 그럴까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av alle menneskene i familien din, hvem sin død ville du funnet mest forstyrrende? Hvorfor?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van alle mensen in je familie, wiens dood zou je het meest verontrustend vinden? Waarom?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze wszystkich osób w twojej rodzinie, czyja śmierć byłaby dla ciebie najbardziej niepokojąca? Dlaczego?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De todas as pessoas da sua família, cuja morte você acharia mais perturbadora? Por quê?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
