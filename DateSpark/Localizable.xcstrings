    "You didn't keep any questions this time. Shuffle and try again, or explore a new theme.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben diesmal keine Fragen behalten. Mischen Sie und versuchen Sie es erneut oder erkunden Sie ein neues Thema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't keep any questions this time. Shuffle and try again, or explore a new theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardaste ninguna pregunta esta vez. Baraja e inténtalo de nuevo, o explora un nuevo tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez conservé aucune question cette fois. Mélangez et réessayez, ou explorez un nouveau thème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai conservato nessuna domanda questa volta. Mescola e riprova, oppure esplora un nuovo tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は質問を保存しませんでした。シャッフルして再試行するか、新しいテーマを探索してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 질문을 저장하지 않았습니다. 섞어서 다시 시도하거나 새로운 테마를 탐색하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze keer geen vragen bewaard. Schud en probeer het opnieuw, of verken een nieuw thema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tym razem nie zachowałeś żadnych pytań. Przetasuj i spróbuj ponownie lub odkryj nowy temat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não manteve nenhuma pergunta desta vez. Embaralhe e tente novamente, ou explore um novo tema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次你没有保留任何问题。重新洗牌再试一次，或者探索新主题。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du beholdt ingen spørsmål denne gangen. Bland og prøv igjen, eller utforsk et nytt tema."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behöll inga frågor den här gången. Blanda och försök igen, eller utforska ett nytt tema."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього разу ви не зберегли жодного запитання. Перемішайте та спробуйте знову або дослідіть нову тему."
          }
        }
      }
    },
