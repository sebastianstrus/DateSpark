    "This removes all %lld saved questions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt alle %lld gespeicherten Fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all %lld saved questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las %lld preguntas guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime toutes les %lld questions enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove tutte le %lld domande salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、保存された%lld個の質問すべてが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 %lld개의 질문이 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert alle %lld opgeslagen vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa wszystkie %lld zapisane pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove todas as %lld perguntas salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除所有%lld个保存的问题。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle %lld lagrede spørsmål."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort alla %lld sparade frågor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить усі %lld збережені запитання."
          }
        }
      }
    },
    "Thoughtfully crafted questions designed to move past small talk — for first dates, old friends, and every meaningful encounter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgfältig gestaltete Fragen, die über Small Talk hinausgehen — für erste Dates, alte Freunde und jede bedeutungsvolle Begegnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoughtfully crafted questions designed to move past small talk — for first dates, old friends, and every meaningful encounter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas cuidadosamente diseñadas para ir más allá de la charla trivial — para primeras citas, viejos amigos y cada encuentro significativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions soigneusement conçues pour aller au-delà des banalités — pour les premiers rendez-vous, les vieux amis et chaque rencontre significative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande accuratamente create per andare oltre le chiacchiere — per primi appuntamenti, vecchi amici e ogni incontro significativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初デート、旧友、すべての有意義な出会いのために、世間話を超えるように設計された丁寧に作られた質問。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 데이트, 오랜 친구, 그리고 모든 의미 있는 만남을 위해 가벼운 대화를 넘어서도록 세심하게 만들어진 질문들."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorgvuldig samengestelde vragen die verder gaan dan small talk — voor eerste dates, oude vrienden en elke betekenisvolle ontmoeting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starannie opracowane pytania zaprojektowane, aby wykroczyć poza small talk — na pierwsze randki, starych przyjaciół i każde znaczące spotkanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas cuidadosamente elaboradas para ir além de conversas triviais — para primeiros encontros, velhos amigos e cada encontro significativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精心设计的问题，旨在超越闲聊——适用于初次约会、老朋友和每一次有意义的相遇。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøye utformede spørsmål designet for å bevege seg forbi småprat — for første stevnemøter, gamle venner og hvert meningsfullt møte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noggrant utformade frågor utformade för att gå bortom småprat — för första dejter, gamla vänner och varje meningsfullt möte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продумані запитання, розроблені для того, щоб перейти від дрібних розмов — для перших побачень, старих друзів та кожної значущої зустрічі."
          }
        }
      }
    },
